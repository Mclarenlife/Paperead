{
  "name": "paperead",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "node scripts/prepare-reading.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "prepare:pdf": "node scripts/prepare-pdf.mjs",
    "postinstall": "node scripts/prepare-pdf.mjs",
    "format": "prettier --write src tests scripts docs README.md *.json *.ts src-tauri/*.json src-tauri/capabilities/*.json",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "dev:android": "tauri android dev",
    "dev:ios": "tauri ios dev",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:android": "node scripts/build-native.mjs android",
    "build:macos": "node scripts/build-native.mjs macos",
    "build:ios": "node scripts/build-native.mjs ios"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-ris": "^0.8.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@mathjax/src": "^4.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.6",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
